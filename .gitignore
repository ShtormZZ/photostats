# --- Your data. None of this belongs in the repository ---
# The database holds full file paths, shooting coordinates and every statistic
# derived from the archive.
photos.db
*.db
*.db-journal
*.db-wal
*.db-shm
# The thumbnail cache is pieces of your photos.
cache/
# Exports
*.csv
# Launcher settings: they hold the paths to your folders
settings.json

# --- Environment ---
.venv/
env/
__pycache__/
*.py[cod]

# --- ExifTool, if it was put next to the scripts ---
exiftool.exe
exiftool_files/
exiftool(-k).exe

# --- Editors and the operating system ---
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
